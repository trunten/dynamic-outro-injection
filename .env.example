# Configure these four values in Hostless environment variables.
B2_BUCKET=your-private-bucket
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=

# Optional. Once deployed, set this to the canonical HTTPS Hostless URL.
# PUBLIC_BASE_URL=https://your-app.hostless.app
MAX_MIRRORS=20
MAX_OUTRO_BYTES=8388608
MAX_SOURCE_BYTES=157286400
MAX_CACHE_BYTES=2147483648
MAX_MONTHLY_EGRESS_BYTES=1073741824
MAX_GENERATIONS_PER_DAY=20
FEED_REFRESH_SECONDS=900
CACHE_TTL_DAYS=14

# Administrator dashboard login. Keep this secret in Hostless, never in GitHub.
ADMIN_PASSWORD=
